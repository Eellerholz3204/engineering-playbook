  "optional_project_templates": [
    { "source": "templates/current_milestone.md", "target": "docs/current_milestone.md" }
  ],
  "preservation_rules": {
    "project_owned_roots": ["docs", "scripts", "src", "models", "tests"],
    "unknown_files": "preserve",
    "obsolete_framework_files": "report_only",
    "existing_project_documents": "preserve_and_report_review"
  }
