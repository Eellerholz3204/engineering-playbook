        { "source": "templates/security_and_privacy.md", "target": "docs/security_and_privacy.md" }
      ]
    },
    "powershell": { "label": "PowerShell", "description": "Core engineering guidance for PowerShell projects. No script scaffolding yet.", "templates": [] },
    "dotnet": { "label": ".NET", "description": "Core engineering guidance for .NET projects. No solution scaffolding yet.", "templates": [] },
    "node": { "label": "Node.js", "description": "Core engineering guidance for Node.js projects. No package scaffolding yet.", "templates": [] }
